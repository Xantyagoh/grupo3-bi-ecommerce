{
  "name": "Grupo3 E-commerce",
  "dataColors": ["#1F4E79", "#E8833A", "#3B8E5A", "#8C8C8C", "#5B9BD5", "#C0392B", "#F2C14E", "#7A5C99"],
  "background": "#FFFFFF",
  "foreground": "#252423",
  "tableAccent": "#1F4E79",
  "good": "#3B8E5A",
  "neutral": "#F2C14E",
  "bad": "#C0392B",
  "maximum": "#1F4E79",
  "center": "#F2C14E",
  "minimum": "#EAF0F6",
  "textClasses": {
    "callout":  { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#1F4E79" },
    "title":    { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "header":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#252423" },
    "label":    { "fontSize": 10, "fontFace": "Segoe UI", "color": "#605E5C" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [ { "show": true, "fontSize": 13, "fontColor": { "solid": { "color": "#252423" } } } ],
        "border": [ { "show": false } ],
        "background": [ { "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 } ]
      }
    },
    "page": {
      "*": {
        "background": [ { "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 } ]
      }
    }
  }
}
